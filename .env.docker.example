# Reference only -- docker-compose.yml already sets all of these inline for
# the local verification stack. This file documents what they are and isn't
# read directly by docker-compose; copy values from here into
# docker-compose.yml's `environment:` block if you need to change one (e.g.
# to add real EBAY_/ANTHROPIC_/SERPAPI_ keys to test those features locally
# under Docker rather than via `npm run dev`).

DB_CLIENT=pg
DATABASE_URL=postgres://postgres:postgres@db:5432/rebooty_dev
SESSION_SECRET=local-docker-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
APP_PUBLIC_URL=http://localhost:3000
REBOOTY_UPLOADS_DIR=/data/uploads
EBAY_ENV=sandbox

# Optional -- only needed to exercise these specific features under Docker
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
