<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Log a Sale</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main>
    <h1>Log a Sale</h1>
    <%- include('partials/nav') %>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (item) { %>
      <div class="card">
        <div class="sku"><%= item.sku %></div>
        <div><%= item.item_name || '—' %></div>
      </div>
    <% } %>

    <form method="POST" action="/sales">
      <label for="sku">SKU</label>
      <input type="text" id="sku" name="sku" value="<%= sku %>" required <%= item ? 'readonly' : '' %>>

      <label for="platform">Platform</label>
      <select id="platform" name="platform" required>
        <option value="">—</option>
        <% constants.PLATFORMS.forEach(function(p) { %>
          <option value="<%= p %>"><%= p %></option>
        <% }); %>
      </select>

      <label for="sale_date">Sale date</label>
      <input type="date" id="sale_date" name="sale_date" value="<%= today %>" required>

      <label for="sale_price">Sale price</label>
      <input type="number" id="sale_price" name="sale_price" step="0.01" min="0" inputmode="decimal" required>

      <label for="shipping_charged">Shipping charged to buyer</label>
      <input type="number" id="shipping_charged" name="shipping_charged" step="0.01" min="0" inputmode="decimal" value="0">

      <label for="shipping_cost">Shipping cost you paid</label>
      <input type="number" id="shipping_cost" name="shipping_cost" step="0.01" min="0" inputmode="decimal">

      <label for="other_fees">Other fees</label>
      <input type="number" id="other_fees" name="other_fees" step="0.01" min="0" inputmode="decimal" value="0">

      <button type="submit">Save Sale</button>
    </form>
  </main>
</body>
</html>
