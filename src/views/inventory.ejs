<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Inventory</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main>
    <h1>Inventory (<%= items.length %>)</h1>
    <%- include('partials/nav') %>

    <table>
      <thead>
        <tr>
          <th>SKU</th>
          <th>Item</th>
          <th>Bin/Loc</th>
          <th>Status</th>
          <th>List Price</th>
          <th>Acquired</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr onclick="location.href='/inventory/<%= item.sku %>/edit'" style="cursor:pointer;">
            <td><%= item.sku %></td>
            <td><%= item.item_name || '—' %></td>
            <td><%= item.bin_location || '—' %></td>
            <td class="status-<%= item.status.replace(' ', '-') %>"><%= item.status %></td>
            <td><%= item.list_price ? '$' + Number(item.list_price).toFixed(2) : '—' %></td>
            <td><%= item.date_acquired || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
