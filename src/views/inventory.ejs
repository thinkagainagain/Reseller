<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Inventory</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main>
    <h1>Inventory (<%= items.length %>)</h1>
    <nav>
      <a href="/intake">+ New Intake</a>
      <a href="/intake/queue">Intake Queue</a>
    </nav>

    <table>
      <thead>
        <tr>
          <th>SKU</th>
          <th>Item</th>
          <th>Status</th>
          <th>Acquired</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(item) { %>
          <tr>
            <td><%= item.sku %></td>
            <td><%= item.item_name || '—' %></td>
            <td class="status-<%= item.status.replace(' ', '-') %>"><%= item.status %></td>
            <td><%= item.date_acquired %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
