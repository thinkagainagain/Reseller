<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Intake</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main>
    <h1>Intake a new item</h1>
    <%- include('../partials/nav') %>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/intake" enctype="multipart/form-data">
      <label for="photos">Photo(s) of the item</label>
      <input type="file" id="photos" name="photos" accept="image/*" multiple required>

      <label for="sku_prefix">SKU prefix</label>
      <input type="text" id="sku_prefix" name="sku_prefix" value="<%= defaultPrefix %>" maxlength="10" style="text-transform:uppercase;">
      <div class="stat-sub" style="margin:-0.75rem 0 0.5rem;">Numbers count up separately per prefix. Change this when listing on someone else's behalf -- leave it as <%= defaultPrefix %> otherwise.</div>

      <label for="item_name">Title (optional)</label>
      <input type="text" id="item_name" name="item_name" placeholder="e.g. Vintage Pyrex mixing bowl">

      <label for="purchase_cost">Cost of goods (optional)</label>
      <input type="number" id="purchase_cost" name="purchase_cost" step="0.01" min="0" inputmode="decimal" placeholder="0.00">

      <button type="submit">Save to Intake</button>
    </form>
  </main>
</body>
</html>
