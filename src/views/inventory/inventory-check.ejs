<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Inventory Check</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main class="wide">
    <h1>Inventory Check</h1>
    <%- include('../partials/nav') %>

    <p>Find the items you want to check by hand, download them as an Excel sheet, and
      print it. Items are grouped by bin location so the printout follows a walk
      through the house. After checking, fix the Location column (and mark anything
      you can't find), then paste it back in with
      <a href="/inventory/import-bins">Import Bin Locations</a>.</p>

    <form method="GET" action="/inventory/check">
      <label for="q">Keyword (title, SKU, or bin)</label>
      <input type="text" id="q" name="q" value="<%= filters.keyword %>" placeholder="e.g. mug, or Kitchen1">

      <label for="bin">Bin location</label>
      <select id="bin" name="bin">
        <option value="">All bins</option>
        <option value="<%= noBin %>" <%= filters.bin === noBin ? 'selected' : '' %>>(no location set)</option>
        <% bins.forEach(function(b) { %>
          <option value="<%= b %>" <%= filters.bin === b ? 'selected' : '' %>><%= b %></option>
        <% }); %>
      </select>

      <% if (categories.length > 0) { %>
        <label for="category">Category</label>
        <select id="category" name="category">
          <option value="">All categories</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      <% } %>

      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="on-hand" <%= filters.status === 'on-hand' ? 'selected' : '' %>>On hand (everything except Sold, Donated, Trashed, Returned)</option>
        <% statuses.forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>

      <button type="submit">Search</button>
    </form>

    <h2 class="section-heading"><%= total %> item<%= total === 1 ? '' : 's' %> found</h2>

    <% if (total > 0) { %>
      <a class="button-secondary" href="/inventory/check/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>">Download Excel (<%= total %> item<%= total === 1 ? '' : 's' %>)</a>
      <% if (total > previewLimit) { %>
        <p>Showing the first <%= previewLimit %> below — the Excel file includes all <%= total %>.</p>
      <% } %>

      <div class="table-scroll">
        <table>
          <thead><tr><th>SKU</th><th>Item</th><th>Location</th><th>Status</th></tr></thead>
          <tbody>
            <% items.forEach(function(item) { %>
              <tr>
                <td><a href="/inventory/<%= item.sku %>/edit"><%= item.sku %></a></td>
                <td><%= item.item_name || '—' %></td>
                <td><%= item.bin_location || '—' %></td>
                <td><%= item.status %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p>Nothing matches — try fewer words or a different bin.</p>
    <% } %>
  </main>
</body>
</html>
