<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Edit <%= item.sku %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main>
    <h1><%= item.sku %></h1>
    <%- include('../partials/nav') %>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (photoUrl) { %>
      <div class="preview">
        <img src="<%= photoUrl %>" alt="<%= item.sku %>">
      </div>
    <% } %>

    <% if (aiDraft) { %>
      <div class="card" style="color:#b7791f;font-weight:600;">AI research below — not yet saved. Review, add a clarification note and re-run if something's off, or Save when it looks right.</div>
    <% } %>

    <% if (hasPhoto) { %>
      <div class="card">
        <form method="POST" action="/inventory/<%= item.sku %>/generate-ai" onsubmit="this.querySelector('button[type=submit]').disabled=true;">
          <input type="hidden" name="return_to" value="<%= returnTo %>">
          <label for="clarification">Clarification notes (optional)</label>
          <textarea id="clarification" name="clarification" placeholder="e.g. It's actually a men's size 10, not 8 -- or the brand is Fossil, not what you found"></textarea>
          <button type="submit" class="button-secondary">Generate with AI</button>
        </form>
      </div>
    <% } %>

    <form method="POST" action="/inventory/<%= item.sku %>/edit">
      <input type="hidden" name="return_to" value="<%= returnTo %>">

      <label for="item_name">Title</label>
      <input type="text" id="item_name" name="item_name" value="<%= item.item_name || '' %>">

      <label for="description">Description</label>
      <textarea id="description" name="description"><%= item.description || '' %></textarea>

      <label for="item_type">eBay "Type" (only if eBay rejects a push for missing it — varies by category, e.g. "Cigarette Case")</label>
      <input type="text" id="item_type" name="item_type" value="<%= item.item_type || '' %>">

      <label for="brand">Brand</label>
      <input type="text" id="brand" name="brand" value="<%= item.brand || '' %>">

      <label for="item_size">Size</label>
      <input type="text" id="item_size" name="item_size" value="<%= item.item_size || '' %>">

      <label for="color">Color</label>
      <input type="text" id="color" name="color" value="<%= item.color || '' %>">

      <label for="year_manufactured">Year of manufacture</label>
      <input type="text" id="year_manufactured" name="year_manufactured" value="<%= item.year_manufactured || '' %>">

      <label for="country_of_origin">Country of origin</label>
      <input type="text" id="country_of_origin" name="country_of_origin" value="<%= item.country_of_origin || '' %>">

      <label for="status">Status</label>
      <select id="status" name="status">
        <% constants.STATUSES.forEach(function(s) { %>
          <option value="<%= s %>" <%= item.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>

      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">—</option>
        <% constants.CATEGORIES.forEach(function(c) { %>
          <option value="<%= c %>" <%= item.category === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>

      <label for="ebay_category_name">eBay category (AI-suggested)</label>
      <input type="text" id="ebay_category_name" name="ebay_category_name" value="<%= item.ebay_category_name || '' %>">
      <input type="hidden" id="ebay_category_id" name="ebay_category_id" value="<%= item.ebay_category_id || '' %>">

      <label for="source">Source</label>
      <select id="source" name="source">
        <option value="">—</option>
        <% constants.SOURCES.forEach(function(s) { %>
          <option value="<%= s %>" <%= item.source === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>

      <label for="condition">Condition</label>
      <select id="condition" name="condition">
        <option value="">—</option>
        <% constants.CONDITIONS.forEach(function(c) { %>
          <option value="<%= c %>" <%= item.condition === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>

      <label for="purchase_cost">Cost of goods</label>
      <input type="number" id="purchase_cost" name="purchase_cost" step="0.01" min="0" inputmode="decimal" value="<%= item.purchase_cost ?? '' %>">

      <label for="list_price">List price</label>
      <input type="number" id="list_price" name="list_price" step="0.01" min="0" inputmode="decimal" value="<%= item.list_price ?? '' %>">

      <label for="weight_lbs">Package weight — lbs</label>
      <input type="number" id="weight_lbs" name="weight_lbs" step="1" min="0" inputmode="numeric" value="<%= item.weight_lbs ?? '' %>">

      <label for="weight_oz">Package weight — oz</label>
      <input type="number" id="weight_oz" name="weight_oz" step="1" min="0" max="15" inputmode="numeric" value="<%= item.weight_oz ?? '' %>">

      <label for="package_length">Package length (in)</label>
      <input type="number" id="package_length" name="package_length" step="0.5" min="0" inputmode="decimal" value="<%= item.package_length ?? '' %>">

      <label for="package_width">Package width (in)</label>
      <input type="number" id="package_width" name="package_width" step="0.5" min="0" inputmode="decimal" value="<%= item.package_width ?? '' %>">

      <label for="package_height">Package height (in)</label>
      <input type="number" id="package_height" name="package_height" step="0.5" min="0" inputmode="decimal" value="<%= item.package_height ?? '' %>">

      <label for="bin_location">Bin location</label>
      <input type="text" id="bin_location" name="bin_location" value="<%= item.bin_location || '' %>">

      <label for="date_acquired">Date acquired</label>
      <input type="date" id="date_acquired" name="date_acquired" value="<%= item.date_acquired || '' %>">

      <label for="death_pile_reason">Death Pile reason</label>
      <select id="death_pile_reason" name="death_pile_reason">
        <option value="">—</option>
        <% constants.DEATH_PILE_REASONS.forEach(function(r) { %>
          <option value="<%= r %>" <%= item.death_pile_reason === r ? 'selected' : '' %>><%= r %></option>
        <% }); %>
      </select>

      <label for="death_pile_action_plan">Death Pile action plan</label>
      <select id="death_pile_action_plan" name="death_pile_action_plan">
        <option value="">—</option>
        <% constants.DEATH_PILE_ACTION_PLANS.forEach(function(a) { %>
          <option value="<%= a %>" <%= item.death_pile_action_plan === a ? 'selected' : '' %>><%= a %></option>
        <% }); %>
      </select>

      <label for="notes">Notes</label>
      <textarea id="notes" name="notes"><%= item.notes || '' %></textarea>

      <button type="submit">Save</button>
    </form>
    <%
      const cancelHref = { queue: '/intake/queue', 'death-pile': '/inventory/death-pile', sold: '/inventory/sold' }[returnTo] || '/inventory';
    %>
    <a class="button-secondary" href="<%= cancelHref %>">Cancel</a>

    <% if (item.status !== 'Sold') { %>
      <a class="button-secondary" href="/sales/new?sku=<%= item.sku %>">Log Sale</a>
    <% } %>

    <form method="POST" action="/inventory/<%= item.sku %>/delete" onsubmit="return confirm('Delete <%= item.sku %>? This cannot be undone.');">
      <input type="hidden" name="return_to" value="<%= returnTo %>">
      <button type="submit" class="button-secondary" style="border-color:#c53030;color:#c53030;">Delete item</button>
    </form>
  </main>
</body>
</html>
