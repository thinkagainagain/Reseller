<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Inventory</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main class="wide">
    <h1>Inventory — Active (<%= items.length %>)</h1>
    <%- include('../partials/nav') %>

    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Photo</th>
            <th>SKU</th>
            <th>Item</th>
            <th>Bin/Loc</th>
            <th>List Price</th>
            <th>Acquired</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(item) { %>
            <tr onclick="location.href='/inventory/<%= item.sku %>/edit'" style="cursor:pointer;">
              <td>
                <% if (item.ebay_primary_photo_url) { %>
                  <img class="thumb" src="<%= item.ebay_primary_photo_url %>" alt="<%= item.sku %>">
                <% } %>
              </td>
              <td><%= item.sku %></td>
              <td><%= item.item_name || '—' %></td>
              <td><%= item.bin_location || '—' %></td>
              <td><%= item.list_price ? '$' + Number(item.list_price).toFixed(2) : '—' %></td>
              <td><%= item.date_acquired || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
