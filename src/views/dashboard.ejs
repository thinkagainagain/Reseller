<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Dashboard</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main class="wide">
    <h1>Dashboard</h1>
    <%- include('partials/nav') %>

    <div class="stat-grid">
      <div class="card stat-card">
        <div class="stat-label">Active Listings</div>
        <div class="stat-value"><%= activeCount %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Waiting to List</div>
        <div class="stat-value"><%= waitingCount %></div>
        <div class="stat-sub">$<%= waitingTiedUp.toFixed(2) %> tied up</div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Death Pile</div>
        <div class="stat-value"><%= deathPileCount %></div>
        <div class="stat-sub">$<%= deathPileTiedUp.toFixed(2) %> tied up</div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Sold (all-time)</div>
        <div class="stat-value"><%= soldCount %></div>
      </div>
    </div>

    <h2 class="section-heading">Listing Velocity</h2>
    <div class="stat-grid">
      <div class="card stat-card">
        <div class="stat-label">Listed Today</div>
        <div class="stat-value"><%= listedToday %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Listed This Week</div>
        <div class="stat-value"><%= listedThisWeek %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Avg. Days to List</div>
        <div class="stat-value"><%= avgDaysToList === null ? '—' : avgDaysToList.toFixed(1) %></div>
      </div>
    </div>

    <h2 class="section-heading">Profit (last 90 days)</h2>
    <div class="chart-grid">
      <div class="card chart-card">
        <div class="chart-card-title">By Platform</div>
        <% if (platformProfit.length === 0) { %>
          <p>No sales in this window yet.</p>
        <% } else { %>
          <canvas id="platformChart"></canvas>
          <% platformProfit.forEach(function(p) { %>
            <div class="breakdown-row">
              <span><%= p.label %></span>
              <span>$<%= p.profit.toFixed(2) %> · <%= p.marginPct.toFixed(1) %>% · <%= p.count %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
      <div class="card chart-card">
        <div class="chart-card-title">By Month</div>
        <% if (monthlyProfit.length === 0) { %>
          <p>No sales in this window yet.</p>
        <% } else { %>
          <canvas id="monthChart"></canvas>
          <% monthlyProfit.forEach(function(m) { %>
            <div class="breakdown-row">
              <span><%= m.label %></span>
              <span>$<%= m.profit.toFixed(2) %> · <%= m.marginPct.toFixed(1) %>% · <%= m.count %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <h2 class="section-heading">Recent Sales</h2>
    <% if (recentSales.length === 0) { %>
      <p>No sales yet.</p>
    <% } %>
    <% recentSales.forEach(function(sale) { %>
      <div class="card">
        <div class="sku"><%= sale.sku %></div>
        <div><%= sale.item_name || '—' %></div>
        <div><%= sale.platform %> · $<%= Number(sale.sale_price).toFixed(2) %> · <%= sale.sale_date %></div>
        <div>Profit: $<%= sale.profit.toFixed(2) %> (<%= sale.marginPct.toFixed(1) %>%)</div>
      </div>
    <% }); %>
  </main>

  <% if (platformProfit.length > 0 || monthlyProfit.length > 0) { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
      const platformData = <%- JSON.stringify(platformProfit) %>;
      const monthlyData = <%- JSON.stringify(monthlyProfit) %>;
      const palette = ['#2b6cb0', '#2f855a', '#b7791f', '#c53030', '#6b46c1', '#0d9488', '#dd6b20', '#718096'];

      if (platformData.length > 0) {
        new Chart(document.getElementById('platformChart'), {
          type: 'doughnut',
          data: {
            labels: platformData.map((p) => p.label),
            datasets: [{
              data: platformData.map((p) => p.profit),
              backgroundColor: palette,
            }],
          },
          options: { plugins: { legend: { position: 'bottom' } } },
        });
      }

      if (monthlyData.length > 0) {
        new Chart(document.getElementById('monthChart'), {
          type: 'bar',
          data: {
            labels: monthlyData.map((m) => m.label),
            datasets: [
              { label: 'Revenue', data: monthlyData.map((m) => m.revenue), backgroundColor: '#cbd5e0' },
              { label: 'Profit', data: monthlyData.map((m) => m.profit), backgroundColor: '#2b6cb0' },
            ],
          },
          options: { plugins: { legend: { position: 'bottom' } } },
        });
      }
    </script>
  <% } %>
</body>
</html>
