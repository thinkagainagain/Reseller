<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReBooty Ops — Waiting to List</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body>
  <main>
    <h1>Waiting to List (<%= items.length %>)</h1>
    <%- include('partials/nav') %>

    <% if (items.length === 0) { %>
      <p>Nothing waiting to be listed right now.</p>
    <% } else { %>
      <p>$<%= totalTiedUp.toFixed(2) %> tied up waiting to list</p>
    <% } %>

    <% items.forEach(function(item) { %>
      <div class="card">
        <a href="/inventory/<%= item.sku %>/edit?from=queue">
          <% if (firstPhotoBySku[item.sku]) { %>
            <img src="<%= firstPhotoBySku[item.sku] %>" alt="<%= item.sku %>">
          <% } %>
          <div class="sku"><%= item.sku %></div>
          <% if (item.item_name) { %>
            <div><%= item.item_name %></div>
          <% } %>
          <% if (item.purchase_cost) { %>
            <div>Cost: $<%= Number(item.purchase_cost).toFixed(2) %></div>
          <% } %>
          <div>Acquired: <%= item.date_acquired %></div>
        </a>
        <form method="POST" action="/inventory/<%= item.sku %>/delete" onsubmit="return confirm('Delete <%= item.sku %>? This cannot be undone.');">
          <input type="hidden" name="return_to" value="queue">
          <button type="submit" class="button-secondary" style="border-color:#c53030;color:#c53030;margin-top:0.5rem;">Delete</button>
        </form>
      </div>
    <% }); %>
  </main>
</body>
</html>
