{
  "name": "rebooty-ops",
  "version": "0.1.0",
  "private": true,
  "description": "ReBooty Treasures reselling ops app (intake, inventory, eBay sync, dashboard)",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "knex --knexfile src/db/knexfile.js migrate:latest",
    "seed": "knex --knexfile src/db/knexfile.js seed:run",
    "sync:ebay": "node src/scripts/syncEbay.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "fast-xml-parser": "^5.10.1",
    "knex": "^3.1.0",
    "multer": "^2.0.1",
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
