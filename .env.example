# Copy this file to .env and fill in real values. Never commit .env.

# eBay Developer app credentials (developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=

# eBay OAuth refresh token (obtained via one-time three-legged consent flow)
# Wrap in double quotes -- eBay tokens contain '#' characters, which dotenv
# otherwise treats as a comment and silently truncates the value.
EBAY_REFRESH_TOKEN=""

# eBay environment: sandbox or production
EBAY_ENV=production

# --- App (Node/Express) ---

# SQLite database file, relative to repo root
DB_FILE=./data/rebooty.sqlite3

# Random long string used to sign session cookies
SESSION_SECRET=change-me-to-a-random-string

# Seeded on first `npm run seed` as the single dashboard login
ADMIN_USERNAME=
ADMIN_PASSWORD=

PORT=3000
