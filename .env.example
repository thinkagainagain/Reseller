# Copy this file to .env and fill in real values. Never commit .env.

# eBay Developer app credentials (developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=

# eBay OAuth refresh token (obtained via one-time three-legged consent flow)
# Wrap in double quotes -- eBay tokens contain '#' characters, which dotenv
# otherwise treats as a comment and silently truncates the value.
EBAY_REFRESH_TOKEN=""

# eBay environment: sandbox or production
EBAY_ENV=production

# Anthropic API key (console.anthropic.com/settings/keys) -- used for the
# "Generate with AI" button on the item edit page, to draft listing fields
# from the intake photo. Requires billing/credits enabled on the account.
ANTHROPIC_API_KEY=

# SerpApi key (serpapi.com) -- runs the intake photo through real Google
# Lens for "Generate with AI", to find actual matching product listings and
# prices (much stronger identification than image description alone).
SERPAPI_KEY=

# Base URL this app is publicly reachable at -- needed so SerpApi's Google
# Lens can fetch the intake photo by URL (it requires a public image URL,
# not a file upload). Set to the real domain in production
# (https://ops.rebootytreasures.com); local dev won't work with Lens since
# localhost isn't publicly reachable, but the rest of Generate with AI still
# functions locally.
APP_PUBLIC_URL=http://localhost:3000

# eBay business policy IDs (payment/return/shipping) used when pushing a
# "Ready to Publish" item live as a scheduled listing. Retrieved via the
# legacy Trading API GetUserPreferences call (ShowSellerProfilePreferences) --
# the modern REST equivalent needs a write scope this app's token doesn't
# have. The account may have multiple policies of each type with none marked
# default; these must be picked deliberately, not guessed.
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# Ship-from address (ZIP + country only) used directly in each scheduled
# listing request. The legacy Trading API's AddFixedPriceItem just wants
# these as plain fields -- no separate "merchant location" API resource
# needed (that's a modern Inventory API concept, and creating one needs a
# write scope this app's token doesn't have either).
EBAY_SHIP_FROM_POSTAL_CODE=
EBAY_SHIP_FROM_COUNTRY=US

# --- App (Node/Express) ---

# DB_CLIENT unset/blank = SQLite (local dev default, just a file).
# Set DB_CLIENT=pg in production (Supabase's managed Postgres, connected via
# Hostinger's "Connect a database" Web App integration -- native SQLite
# drivers don't build on Hostinger's runtime, see git history for why) and
# fill in DATABASE_URL below.
DB_CLIENT=

# SQLite database file, relative to repo root (used when DB_CLIENT is unset)
DB_FILE=./data/rebooty.sqlite3

# Postgres connection string (used when DB_CLIENT=pg), from Supabase's
# Connect > Direct connection panel
DATABASE_URL=

# Whether to use SSL for the Postgres connection. Defaults to true (required
# by Supabase/Render/managed Postgres generally) -- only set to false for a
# local Postgres that doesn't support SSL (e.g. docker-compose).
DB_SSL=

# Absolute path for storing uploaded intake photos, outside the app's own
# source tree. REQUIRED in production -- Hostinger's auto-deploy creates a
# brand-new versioned folder on every push, so anything saved relative to the
# app's own directory (like a plain public/uploads folder) gets orphaned in
# the previous deploy's folder the moment the next deploy happens. Leave
# unset for local dev, where this isn't a concern (falls back to
# public/uploads inside the repo).
# NOTE: must be named exactly REBOOTY_UPLOADS_DIR -- Hostinger's panel
# silently refuses to save a variable named plain "UPLOADS_DIR" (confirmed
# reserved/internal name collision, not a value problem).
REBOOTY_UPLOADS_DIR=

# Random long string used to sign session cookies
SESSION_SECRET=change-me-to-a-random-string

# Seeded on first `npm run seed` as the single dashboard login
ADMIN_USERNAME=
ADMIN_PASSWORD=

PORT=3000
